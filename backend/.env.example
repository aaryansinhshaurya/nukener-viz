DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET_KEY=replace-with-a-long-random-value
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,https://your-project.vercel.app
MAX_UPLOAD_BYTES=20971520

# Recommended on Render Free: HTTPS email delivery through Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Configure an SMTP provider for invitations and password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
